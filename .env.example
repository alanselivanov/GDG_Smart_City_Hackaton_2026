# Optional. Default: ./data/astana.sqlite3
DATABASE_PATH=./data/astana.sqlite3
# Optional. Public Overpass requires no API key. Set a distinct contact in User-Agent.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_USER_AGENT=AstanaWalksHackathon/1.0 (contact: your-email@example.com)
POI_REFRESH_HOURS=24
AUTO_REFRESH=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Required only to enable POST /v1/admin/refresh; choose a long random value.
ADMIN_TOKEN=
# Optional OpenAI-compatible chat-completions API for polished grounded explanations.
# If unset, the fully functional built-in grounded generator is used.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
