# Optional. Default: ./data/astana.sqlite3
DATABASE_PATH=./data/astana.sqlite3
# Optional. Public Overpass requires no API key. Set a distinct contact in User-Agent.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_USER_AGENT=AstanaWalksHackathon/1.0 (contact: your-email@example.com)
POI_REFRESH_HOURS=24
AUTO_REFRESH=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Required only to enable POST /v1/admin/refresh; choose a long random value.
ADMIN_TOKEN=
# Required for semantic retrieval; the backend sends POI text and query text to Embeddings API.
# Also enables GPT to select only server-verified recommendation text.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
# Public Valhalla OSM pedestrian routing demo; self-host for sustained production traffic.
ROUTING_URL=https://valhalla1.openstreetmap.de
ROUTING_TIMEOUT_SECONDS=20
# Narrow Astana place lookup for named starting points. Public Nominatim is for low traffic only.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=AstanaWalksHackathon/1.0 (contact: your-email@example.com)
GEOCODER_TIMEOUT_SECONDS=15

# OSM identity of an airport road-access node; coordinates refresh with the daily POI import.
# It is not a verified terminal entrance. Change the node ID if you identify a better drop-off point.
AIRPORT_ROUTE_OSM_NODE_ID=14089441237
# Official OpenStreetMap API for fetching the node coordinates once a day.
OSM_API_URL=https://api.openstreetmap.org
